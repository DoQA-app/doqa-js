{
  "name": "@doqa-tms/jest",
  "version": "0.1.0",
  "description": "DoQA adapter for Jest: test results, steps and attachments go straight to DoQA TMS",
  "keywords": [
    "doqa",
    "jest",
    "test-management",
    "tms",
    "reporter",
    "allure"
  ],
  "license": "Apache-2.0",
  "author": "DoQA team <support@doqa.app>",
  "homepage": "https://github.com/doqa-app/doqa-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doqa-app/doqa-js.git"
  },
  "bugs": {
    "url": "https://github.com/doqa-app/doqa-js/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test doqa-client/tests/*.test.cjs doqa-js-commons/tests/*.test.cjs doqa-jest/tests/*.test.cjs",
    "pack": "node scripts/pack.cjs",
    "version:check": "node scripts/check-version.cjs",
    "test:packages": "node scripts/test-packages.cjs",
    "version:set": "node scripts/version.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "@jest/test-sequencer": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0"
  },
  "type": "commonjs",
  "main": "dist/doqa-jest/src/index.js",
  "types": "dist/doqa-jest/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "doqa-client/README.md",
    "doqa-js-commons/README.md",
    "doqa-jest/README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/doqa-jest/src/index.d.ts",
      "import": "./dist/doqa-jest/src/index.mjs",
      "require": "./dist/doqa-jest/src/index.js"
    },
    "./jest": {
      "types": "./dist/doqa-jest/src/index.d.ts",
      "import": "./dist/doqa-jest/src/index.mjs",
      "require": "./dist/doqa-jest/src/index.js"
    },
    "./client": {
      "types": "./dist/doqa-client/src/index.d.ts",
      "import": "./dist/doqa-client/src/index.mjs",
      "require": "./dist/doqa-client/src/index.js"
    },
    "./commons": {
      "types": "./dist/doqa-js-commons/src/index.d.ts",
      "import": "./dist/doqa-js-commons/src/index.mjs",
      "require": "./dist/doqa-js-commons/src/index.js"
    },
    "./reporter": "./dist/doqa-jest/src/reporter.js",
    "./environment-node": "./dist/doqa-jest/src/environment-node.js",
    "./environment-jsdom": "./dist/doqa-jest/src/environment-jsdom.js",
    "./sequencer": "./dist/doqa-jest/src/sequencer.js",
    "./commons/session": {
      "types": "./dist/doqa-js-commons/src/session.d.ts",
      "default": "./dist/doqa-js-commons/src/session.js"
    },
    "./commons/coordinator": {
      "types": "./dist/doqa-js-commons/src/coordinator.d.ts",
      "default": "./dist/doqa-js-commons/src/coordinator.js"
    }
  },
  "dependencies": {
    "undici": "^7.29.1"
  },
  "peerDependencies": {
    "@jest/test-sequencer": "^29.7.0 || ^30.0.0",
    "jest": "^29.7.0 || ^30.0.0",
    "jest-environment-jsdom": "^29.7.0 || ^30.0.0",
    "jest-environment-node": "^29.7.0 || ^30.0.0"
  },
  "peerDependenciesMeta": {
    "jest-environment-jsdom": {
      "optional": true
    }
  }
}
